rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to validate text length
    function isValidText(text) {
      return text is string && 
             text.size() > 0 && 
             text.size() <= 1000;
    }
    
    // Helper function to validate geo-cell format
    function isValidGeoCell(geoCell) {
      return geoCell is string && 
             (geoCell.matches('^-?[0-9]+_-?[0-9]+$') || geoCell.matches('^room_[0-9]{4,10}$'));
    }
    
    // Snippets collection rules
    match /snippets/{snippetId} {
      allow read: if true;
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.owner_id &&
                       isValidText(request.resource.data.text) && 
                       isValidGeoCell(request.resource.data.geo_cell) &&
                       request.resource.data.expires_at is timestamp &&
                       request.resource.data.expires_at > request.time &&
                       request.resource.data.expires_at <= request.time + duration.value(86400, 's');
      allow update: if request.auth != null &&
                       request.auth.uid == resource.data.owner_id &&
                       request.resource.data.owner_id == resource.data.owner_id &&
                       request.resource.data.geo_cell == resource.data.geo_cell &&
                       request.resource.data.expires_at == resource.data.expires_at &&
                       isValidText(request.resource.data.text);
      allow delete: if request.auth != null &&
                       request.auth.uid == resource.data.owner_id;
    }
    
    // Rooms collection rules
    match /rooms/{roomId} {
      allow list: if false;
      allow get: if true;
      allow create, update, delete: if true;
    }

    // PDF Links rules
    match /pdf_links/{linkId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Allow anyone to increment views, but only owner can update other fields
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']))
                    || (request.auth != null && request.auth.uid == resource.data.owner_id);
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner_id;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Subscription audit logs
    match /subscriptions/{subId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid == resource.data.user_id);
      allow create: if request.auth != null;
    }
  }
}
